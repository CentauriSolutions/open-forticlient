#!/bin/sh
set -eu

# Before the app was renamed it installed as OFTC.app. Remove that copy only if
# it is exactly our bundle, so two apps never share one bundle identifier.
old=/Applications/OFTC.app
if [ -d "$old" ] && [ ! -L "$old" ] &&
   [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$old/Contents/Info.plist" 2>/dev/null)" = com.chris.openforticlient.oftc ]; then
    /bin/rm -rf "$old"
fi

# The signed app owns onboarding. A package install can only hand off to the
# logged-in user; managed and headless installs finish without a GUI session.
if ! /usr/bin/pgrep -x Installer >/dev/null 2>&1; then
    exit 0
fi
console_user=$(/usr/bin/stat -f %Su /dev/console)
case "$console_user" in
    root|loginwindow|_mbsetupuser|'') exit 0 ;;
esac
console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null) || exit 0
case "$console_uid" in
    ''|*[!0-9]*|0) exit 0 ;;
esac
app="/Applications/Open Forticlient.app"
if [ -d "$app" ]; then
    /usr/bin/sudo -u "$console_user" /bin/launchctl asuser "$console_uid" \
        /usr/bin/open "$app" --args --after-install >/dev/null 2>&1 || true
fi
exit 0
