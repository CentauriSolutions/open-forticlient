#!/bin/sh
set -eu

# Replacing an active app binary can interrupt an extension or supervisor.
# The operator must stop OFTC before an update. Fresh installs pass directly.
if /usr/bin/pgrep -f '^/Applications/OFTC\.app/Contents/MacOS/OFTCAgent([[:space:]]|$)' >/dev/null 2>&1; then
    echo 'OFTC is running. Disconnect the VPN and quit OFTC before updating. Open OFTC from Applications if its controls are hidden.' >&2
    exit 1
fi
# Every profile has its own VPN entry ("OFTC VPN", "OFTC VPN (<name>)", ...).
active=$(/usr/sbin/scutil --nc list 2>/dev/null | /usr/bin/grep 'com\.chris\.openforticlient\.oftc' \
    | /usr/bin/grep -E '\((Connected|Connecting|Disconnecting|Reasserting)\)' || true)
if [ -n "$active" ]; then
    echo 'An OFTC VPN is active. Disconnect every OFTC VPN before updating.' >&2
    exit 1
fi
exit 0
